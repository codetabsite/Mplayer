<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/btnBack"
                android:layout_width="48dp" android:layout_height="48dp"
                android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="⚡ Power User Mode" android:textColor="@color/text_primary" android:textSize="18sp"/>
            <Button android:id="@+id/btnSavePower"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Save"/>
        </LinearLayout>

        <Switch android:id="@+id/swPowerUser"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Power User Mode" android:textColor="@color/text_primary" android:layout_marginBottom="12dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="PLAYBACK" android:textColor="@color/accent" android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <Switch android:id="@+id/swGapless"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Gapless Playback" android:textColor="@color/text_primary"/>
        <Switch android:id="@+id/swReplayGain"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ReplayGain" android:textColor="@color/text_primary"/>
        <Switch android:id="@+id/swNormalize"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Normalize Volume" android:textColor="@color/text_primary"/>
        <Switch android:id="@+id/swSkipSilence"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Skip Silence" android:textColor="@color/text_primary"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Crossfade (seconds)" android:textColor="@color/text_dim"
            android:textSize="13sp" android:layout_marginTop="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <SeekBar android:id="@+id/seekCrossfade"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            <TextView android:id="@+id/tvCrossfadeVal"
                android:layout_width="48dp" android:layout_height="wrap_content"
                android:text="0s" android:textColor="@color/text_primary" android:gravity="end"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Fade In (ms)" android:textColor="@color/text_dim"
            android:textSize="13sp" android:layout_marginTop="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <SeekBar android:id="@+id/seekFadeIn"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            <TextView android:id="@+id/tvFadeInVal"
                android:layout_width="56dp" android:layout_height="wrap_content"
                android:text="0ms" android:textColor="@color/text_primary" android:gravity="end"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Fade Out (ms)" android:textColor="@color/text_dim"
            android:textSize="13sp" android:layout_marginTop="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <SeekBar android:id="@+id/seekFadeOut"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"/>
            <TextView android:id="@+id/tvFadeOutVal"
                android:layout_width="56dp" android:layout_height="wrap_content"
                android:text="0ms" android:textColor="@color/text_primary" android:gravity="end"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="SYSTEM" android:textColor="@color/accent" android:textSize="12sp"
            android:layout_marginTop="16dp" android:layout_marginBottom="8dp"/>

        <Switch android:id="@+id/swAudioFocus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Audio Focus (pause on other apps)" android:textColor="@color/text_primary"/>
        <Switch android:id="@+id/swResume"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Resume Playback on Launch" android:textColor="@color/text_primary"/>

    </LinearLayout>
</ScrollView>
