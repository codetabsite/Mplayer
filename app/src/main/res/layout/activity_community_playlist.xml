<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnBack"
            android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_back" android:background="?attr/selectableItemBackgroundBorderless"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Community Playlists" android:textColor="@color/text_primary" android:textSize="18sp"/>
        <Button android:id="@+id/btnImportById"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="By ID" android:textSize="12sp"/>
    </LinearLayout>

    <!-- Search row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:orientation="horizontal" android:padding="4dp">
        <EditText android:id="@+id/etCommunitySearch"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:hint="Search playlists…" android:textColor="@color/text_primary"
            android:background="@drawable/bg_search" android:paddingHorizontal="12dp"/>
        <Button android:id="@+id/btnCommunitySearch"
            android:layout_width="wrap_content" android:layout_height="match_parent"
            android:text="Go" android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Tab buttons -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:orientation="horizontal">
        <Button android:id="@+id/btnTrending"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="🔥 Trending" android:textSize="11sp"/>
        <Button android:id="@+id/btnPopular"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="⭐ Popular" android:textSize="11sp"/>
        <Button android:id="@+id/btnNew"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:text="🆕 New" android:textSize="11sp"/>
    </LinearLayout>

    <TextView android:id="@+id/tvCommunityStatus"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Loading…" android:textColor="@color/text_dim"
        android:textSize="12sp" android:padding="8dp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCommunity"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
